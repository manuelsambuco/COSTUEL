# Copia questo file in .env per lo sviluppo locale (il .env NON va su GitHub)
DEBUG=true
SECRET_KEY=cambiami
# Vuoto = chiunque può registrarsi. Online mettine uno e dallo solo agli amici.
SIGNUP_CODE=
VAPID_CONTACT=mailto:tuo@indirizzo.it
# Genera con: python manage.py genvapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# In produzione: stringa di connessione PostgreSQL (es. Neon). In locale si usa SQLite.
# DATABASE_URL=postgresql://utente:password@host/db?sslmode=require
# Quota di notifiche di progresso consegnate agli amici (il resto è trattenuto a caso per l'esperimento)
# 1 = tutte consegnate (esperimento spento); es. 0.8 per trattenerne il 20% a caso
NOTIFY_DELIVERY_PROB=1
